{
  "name": "civic-chain",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix blockchain && npm install --prefix server && npm install --prefix client",
    "blockchain": "npm run node --prefix blockchain",
    "compile": "npm run compile --prefix blockchain",
    "deploy": "npm run deploy --prefix blockchain",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}